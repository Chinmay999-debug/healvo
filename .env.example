GROQ_API_KEY=

# Browser-safe — these are read by client code (Vite exposes any VITE_-
# prefixed var to the bundle). The publishable/anon key is not a secret;
# Row Level Security on every table is what actually protects data.
# NEVER add a VITE_-prefixed service-role/secret key here or anywhere else.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
